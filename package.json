{
  "name": "@fanhefeng/dark-mode-toggle-component",
  "version": "1.0.1",
  "description": "A flashlight-style dark mode toggle web component",
  "type": "module",
  "main": "./dist/dark-mode-toggle.umd.js",
  "module": "./dist/dark-mode-toggle.es.js",
  "exports": {
    ".": {
      "import": "./dist/dark-mode-toggle.es.js",
      "require": "./dist/dark-mode-toggle.umd.js",
      "browser": "./dist/dark-mode-toggle.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/fanhefeng/dark-mode-toggle-component.git",
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "keywords": [
    "web-component",
    "dark-mode",
    "toggle",
    "flashlight"
  ],
  "author": "fanhefeng",
  "license": "MIT",
  "devDependencies": {
    "vite": "7.3.7"
  },
  "overrides": {
    "nanoid@3": "3.3.18",
    "picomatch@4": "4.0.4",
    "postcss@8": "8.5.23",
    "rollup@4": "4.59.0",
    "source-map-js@1": "1.2.2"
  }
}
